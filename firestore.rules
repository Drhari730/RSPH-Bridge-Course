rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A save may never reduce a student's recorded progress. Stale or cached
    // copies of the portal used to overwrite these lists with shorter ones.
    function noShrink(field) {
      return !(field in resource.data)
        || !(resource.data[field] is list)
        || (field in request.resource.data
            && request.resource.data[field] is list
            && request.resource.data[field].size() >= resource.data[field].size());
    }

    // The first baseline is the pre-course measure; once saved it can be removed (faculty reset) but never replaced.
    function baselineLocked() {
      return !('baselineScorePct' in resource.data)
        || !(resource.data.baselineScorePct is number)
        || !('baselineScorePct' in request.resource.data)
        || request.resource.data.baselineScorePct == resource.data.baselineScorePct;
    }
    match /students/{studentId} {
      allow read, create, delete: if true;
      allow update: if noShrink('completedLessons') && noShrink('passedQuizzes') && baselineLocked();
    }

    match /meta/{docId} {
      allow read, write: if true;
    }
  }
}
